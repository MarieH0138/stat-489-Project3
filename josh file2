```{r modeling}
library(nnet)

# keeping only common outcomes 
top_outcomes <- nfl_analytics_clean %>%
  count(pass_outcome) %>%
  arrange(desc(n)) %>%
  slice_head(n = 10) %>%  
  pull(pass_outcome)

train_df <- nfl_analytics_clean %>%
  filter(pass_outcome %in% top_outcomes) %>%
  mutate(pass_outcome = droplevels(pass_outcome)) %>%
  # select features you want (down, yards_to_go, score diff, quarter, play_action, formation, etc.)
  mutate(score_diff = pre_snap_home_score - pre_snap_visitor_score,
         is_home = (possession_team == home_team_abbr)) %>%
  select(pass_outcome, possession_team, down, yards_to_go, quarter, score_diff, play_action, offense_formation, receiver_alignment, defenders_in_the_box)

# simplify categorical fields
train_df$offense_formation <- fct_lump(train_df$offense_formation, 10)

multinom_fit <- multinom(pass_outcome ~ possession_team + down + yards_to_go + quarter + score_diff + play_action + offense_formation, data = train_df)

# predict probabilities for a new observation
new_obs <- train_df %>% slice(1) %>% select(-pass_outcome)   # example
predict(multinom_fit, newdata = new_obs, type = "probs")

```

